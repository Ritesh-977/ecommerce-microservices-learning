{
  "name": "ecommerce-microservices-learning",
  "private": true,
  "version": "0.1.0",
  "description": "Learning project: event-driven e-commerce platform with Node.js/TypeScript microservices",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "format": "echo \"No formatter configured at root yet. Run format per service as they are added.\"",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "openapi:validate": "npx --yes @redocly/cli@latest lint \"contracts/**/*.yaml\"",
    "catalog:dev": "npm run dev --workspace @ecommerce/catalog",
    "catalog:test": "npm run test --workspace @ecommerce/catalog",
    "catalog:build": "npm run build --workspace @ecommerce/catalog",
    "catalog:lint": "npm run lint --workspace @ecommerce/catalog",
    "cart:dev": "npm run dev --workspace @ecommerce/cart",
    "cart:test": "npm run test --workspace @ecommerce/cart",
    "cart:build": "npm run build --workspace @ecommerce/cart",
    "cart:lint": "npm run lint --workspace @ecommerce/cart",
    "inventory:dev": "npm run dev --workspace @ecommerce/inventory",
    "inventory:test": "npm run test --workspace @ecommerce/inventory",
    "inventory:test:pg": "npm run test:pg --workspace @ecommerce/inventory",
    "inventory:build": "npm run build --workspace @ecommerce/inventory",
    "inventory:lint": "npm run lint --workspace @ecommerce/inventory",
    "inventory:migrate": "npm run db:migrate --workspace @ecommerce/inventory",
    "inventory:seed": "npm run db:seed --workspace @ecommerce/inventory"
  },
  "engines": {
    "node": ">=20"
  }
}
