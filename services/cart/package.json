{
  "name": "@ecommerce/cart",
  "version": "0.1.0",
  "private": true,
  "description": "Cart service: session carts and line items",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
