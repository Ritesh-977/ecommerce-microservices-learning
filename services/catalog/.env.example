# Catalog service environment (copy to .env for local development)

CATALOG_HOST=0.0.0.0
CATALOG_PORT=3001
LOG_LEVEL=info

# Each service owns its database/schema; no shared DBs across services.
CATALOG_DATABASE_URL=postgresql://ecommerce:change_me_local_only@127.0.0.1:5433/catalog_db?schema=public
