# Example environment variables for local development.
# Copy to .env (do not commit .env) and fill in values as services are added.

# --- General ---
NODE_ENV=development
LOG_LEVEL=info

# --- Local infrastructure (Docker Compose defaults; adjust as needed) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=postgres

# --- Per-service database URLs (each service owns its DB/schema; no shared DBs) ---
# Example pattern: postgresql://user:password@host:port/dbname
CATALOG_DATABASE_URL=
CART_DATABASE_URL=
INVENTORY_DATABASE_URL=
PAYMENT_DATABASE_URL=
ORDER_DATABASE_URL=
SHIPPING_DATABASE_URL=

# --- Service ports (examples; finalize per service) ---
CATALOG_PORT=3001
CART_PORT=3002
INVENTORY_PORT=3003
PAYMENT_PORT=3004
ORDER_PORT=3005
SHIPPING_PORT=3006

# --- Messaging (added when async/events are introduced) ---
# BROKER_TYPE=kafka|rabbitmq
# KAFKA_BROKERS=localhost:9092
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Security/Auth (placeholders; evolve later) ---
# JWT_SECRET=
# SESSION_SECRET=
